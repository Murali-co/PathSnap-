# Laptop 1: directory containing train/ and student_test/. Relative paths are supported.
PATHSNAP_DATA_ROOT=..
PATHSNAP_MODE=development
PATHSNAP_ARTIFACT_DIR=artifacts
# Evaluation: directory directly containing the ten reserved trip directories.
PATHSNAP_EVALUATION_DATA_ROOT=
PATHSNAP_EVALUATION_MANIFEST=
# Optional separate reference root: <root>/<trip_id>/<trip_id>.route
PATHSNAP_REFERENCE_ROOT=
PATHSNAP_LOG_DIR=outputs/logs
PATHSNAP_JOB_TIMEOUT=900
PATHSNAP_MAX_JOBS=32
PATHSNAP_HOST=0.0.0.0
PATHSNAP_PORT=8000
# Laptop 2: set this in its terminal; use Laptop 1's actual LAN IPv4 address.
BACKEND_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=30
JOB_TIMEOUT_SECONDS=900
UI_PORT=8501
